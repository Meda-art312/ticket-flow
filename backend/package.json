{
  "name": "ticketflow-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/infra/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/domain.spec.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "tsx scripts/demo.ts",
    "analyze": "tsx scripts/analyze.ts",
    "contract:export": "tsx scripts/export-contract.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "amqplib": "0.10.9",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "18.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/amqplib": "0.10.7",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.0",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@types/swagger-ui-express": "4.1.8"
  },
  "packageManager": "npm@11.19.0"
}
