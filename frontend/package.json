{
  "name": "ticketflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts vite.config.ts playwright.config.ts",
    "contract:generate": "openapi-typescript docs/ticketflow-api-v1.openapi.json -o src/api/schema.d.ts && node scripts/generate-validators.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "check": "npm run contract:check && node scripts/client-contract-test.mjs && npm run lint && npm run build",
    "e2e": "playwright test",
    "format": "prettier --write src e2e scripts *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
